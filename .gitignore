# Only source code and the files needed to build, run and test it are tracked.
/*
!/.gitignore
!/.gitattributes
!/启动WorldForge.ps1
!/app/

# Application source and build/test configuration allowlist.
/app/*
!/app/backend/
!/app/frontend/
!/app/contracts/
!/app/client/
!/app/tests/
!/app/scripts/
!/app/package.json
!/app/package-lock.json
!/app/.npmrc
!/app/tsconfig.json
!/app/tsconfig.base.json
!/app/playwright.config.ts

# Plans, conversations, instructions, reports and prose stay on this computer.
/PLAN/
/AGENTS.md
/GLOSSARY.md
/GitHub提交规范.md
/README.md
/.github/
/app/README.md
/app/docs/
/app/scripts/export-implementation.mjs
*.md
*.mdx
*.txt
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx

# Dependencies, reproducible builds, caches and local test output.
**/node_modules/
**/dist/
**/test-results/
**/playwright-report/
**/coverage/
**/.npm-cache/
**/__pycache__/
*.pyc
*.log
*.tsbuildinfo

# Actual application data, backups and credentials.
/data/
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
secrets.json

# Failed prototype and personal tool settings.
/egdota/
**/.obsidian/
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db
*.zip
*.7z
*.rar
*.tmp
*.bak
*.swp
